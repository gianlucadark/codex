---
import Bilingual from './Bilingual.astro';
// Absolute index links work from every folio.
import { navLinks as links } from '../data/nav';
import LogoGD from './LogoGD.astro';
---

<header class="island front-nav" data-codex-nav>
	<a class="brand" href="/" aria-label="Torna alla copertina">
		<LogoGD />
		<span class="wordmark">Codex</span>
	</a>

	<nav id="codex-nav-links" class="links" aria-label="Indice del codice">
		<ul>
			{
				links.map((link) => (
					<li>
						<a href={link.href} data-nav-link data-it={link.it} data-en={link.en}>
							{link.it}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<a
		class="return-book"
		href="/?intro=1"
		data-codex-return
		data-it="torna al codice"
		data-en="back to the codex"
		aria-label="Torna al codice"
		title="Torna al codice"
	>
		<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 7H2m0 0 4-4M2 7l4 4M9 6l6-3 7 4v9l-7 4-7-4V9m0-2 7 4 7-4m-7 4v9" /></svg>
		<span><Bilingual it="Libro 3D" en="3D book" /></span>
	</a>

	<div class="lang" role="group" aria-label="Lingua · language">
		<button type="button" class="lang-btn hand-bold active" data-lang-btn="it" aria-pressed="true">it</button>
		<span class="lang-div" aria-hidden="true">·</span>
		<button type="button" class="lang-btn hand-bold" data-lang-btn="en" aria-pressed="false">en</button>
	</div>

	<button
		class="burger"
		type="button"
		aria-expanded="false"
		aria-controls="codex-nav-links"
		aria-label="Apri l'indice"
		data-nav-toggle
	>
		<span></span><span></span><span></span>
	</button>
</header>

<style>
	.front-nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
		height: 72px;
		display: flex;
		align-items: center;
		gap: clamp(12px, 1.6vw, 24px);
		padding: 0 max(var(--gutter), calc((100% - var(--page-width)) / 2 + var(--gutter)));
		color: var(--ink);
		background: var(--stock) var(--sheet) var(--sheet-left) top / var(--sheet-width) auto repeat-y;
		border-bottom: 1px solid var(--rule);
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 9px;
		margin-right: auto;
		text-decoration: none;
	}
	.brand :global(.logo-gd) {
		width: 34px;
	}
	.wordmark {
		font-size: 30px;
		line-height: 1;
		letter-spacing: -0.045em;
	}
	.links ul {
		display: flex;
		align-items: center;
		gap: clamp(10px, 1.55vw, 25px);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.links a {
		display: inline-flex;
		align-items: center;
		min-height: 42px;
		font-size: 18px;
		white-space: nowrap;
		text-decoration: none;
	}
	.links a:is(:hover, :focus-visible),
	.return-book:hover {
		color: var(--accent-ink);
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.return-book {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 36px;
		padding: 0 11px;
		border: 1px solid var(--rule);
		font-size: 17px;
		white-space: nowrap;
		text-decoration: none;
	}
	.return-book svg {
		width: 17px;
		height: 17px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.lang {
		display: flex;
		align-items: center;
	}
	.lang-btn {
		border: 0;
		padding: 5px;
		min-height: 40px;
		color: var(--ink);
		background: transparent;
		font:
			400 26px/1 var(--font-hand),
			cursive;
		text-transform: uppercase;
		cursor: pointer;
	}
	.lang-btn.active {
		color: var(--accent-ink);
		text-decoration: underline;
		text-underline-offset: 5px;
	}
	.burger {
		display: none;
		flex: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 36px;
		height: 42px;
		padding: 7px;
		border: 0;
		background: transparent;
		cursor: pointer;
	}
	.burger span {
		width: 100%;
		height: 1.5px;
		background: var(--ink);
	}
	.open .burger span:nth-child(1) {
		transform: translateY(6.5px) rotate(45deg);
	}
	.open .burger span:nth-child(2) {
		opacity: 0;
	}
	.open .burger span:nth-child(3) {
		transform: translateY(-6.5px) rotate(-45deg);
	}
	@media (max-width: 940px) {
		.front-nav {
			height: 62px;
			gap: 12px;
		}
		.burger {
			display: flex;
		}
		.links {
			display: none;
			position: absolute;
			inset: 100% 0 auto;
			border-bottom: 1px solid var(--rule);
			background: var(--stock) var(--sheet) var(--sheet-left) top / var(--sheet-width) auto;
		}
		.open .links {
			display: block;
		}
		.links ul {
			display: block;
			padding: 6px var(--gutter);
		}
		.links li + li {
			border-top: 1px solid var(--pale-rule);
		}
		.links a {
			display: flex;
			padding-block: 8px;
		}
	}
	@media (max-width: 380px) {
		.front-nav {
			gap: 7px;
		}
		.brand {
			gap: 5px;
		}
		.brand :global(.logo-gd) {
			width: 28px;
		}
		.wordmark {
			display: none;
		}
	}
</style>

<script>
	const nav = document.querySelector<HTMLElement>('[data-codex-nav]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const root = document.documentElement;

	// — Language switch: swap which "voice" is primary —
	const applyLang = (lang: 'it' | 'en') => {
		root.dataset.lang = lang;
		root.lang = lang;
		try {
			localStorage.setItem('codex-lang', lang);
		} catch {}

		// Keep the URL shareable: ?lang=en when English is primary, clean otherwise.
		try {
			const url = new URL(location.href);
			if (lang === 'en') url.searchParams.set('lang', 'en');
			else url.searchParams.delete('lang');
			history.replaceState(null, '', url);
		} catch {}

		document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]').forEach((btn) => {
			const active = btn.dataset.langBtn === lang;
			btn.classList.toggle('active', active);
			btn.setAttribute('aria-pressed', String(active));
		});

		// Localise the index labels to the active language.
		document.querySelectorAll<HTMLElement>('[data-nav-link]').forEach((link) => {
			const label = link.dataset[lang];
			if (label) link.textContent = label;
		});

		// Same for the "return to codex" button's title/aria-label.
		const returnBtn = document.querySelector<HTMLElement>('[data-codex-return]');
		if (returnBtn) {
			const label = returnBtn.dataset[lang];
			if (label) {
				returnBtn.setAttribute('aria-label', label);
				returnBtn.setAttribute('title', label);
			}
		}
	};

	document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]').forEach((btn) => {
		btn.addEventListener('click', () => applyLang(btn.dataset.langBtn === 'en' ? 'en' : 'it'));
	});

	// Sync UI with the language the no-flash head script already chose.
	applyLang(root.dataset.lang === 'en' ? 'en' : 'it');

	// — Mobile menu + scroll-aware styling —
	if (nav && toggle) {
		const close = () => {
			nav.classList.remove('open');
			toggle.setAttribute('aria-expanded', 'false');
		};

		toggle.addEventListener('click', () => {
			const open = nav.classList.toggle('open');
			toggle.setAttribute('aria-expanded', String(open));
		});

		nav.querySelectorAll('[data-nav-link]').forEach((link) => link.addEventListener('click', close));

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') close();
		});

		const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>
