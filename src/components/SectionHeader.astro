---
import Bilingual from './Bilingual.astro';

interface Props { latin?: string; it: string; en: string; folio: string; }
const { latin, it, en, folio } = Astro.props;
---
<header class="heading" data-reveal>
	<div>
		{latin && <p class="imprint rubric">{latin}</p>}
		<h2><Bilingual it={it} en={en} /></h2>
	</div>
	<span class="folio hand-bold">{folio}</span>
</header>

<style>
	.heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: clamp(24px, 3.1vw, 45px);
	}
	.heading .rubric {
		color: var(--accent-ink);
		margin: 0 0 9px;
	}
	h2 {
		margin: 0;
		font-weight: 400;
		font-size: clamp(46px, 6.6vw, 108px);
		line-height: 0.95;
		letter-spacing: -0.055em;
	}
	.folio {
		margin-bottom: 4px;
		font:
			400 var(--hand-folio)/1 var(--font-hand),
			cursive;
		color: var(--accent-ink);
		white-space: nowrap;
	}
	@media (max-width: 520px) {
		.heading {
			position: relative;
		}
		.heading .rubric {
			padding-right: 62px;
			margin-bottom: 13px;
		}
		.folio {
			position: absolute;
			top: -6px;
			right: 0;
			font-size: 29px;
		}
	}
</style>
