---
import SectionHeader from './SectionHeader.astro';
import Bilingual from './Bilingual.astro';
import { facts, stages, features } from '../data/typeface';

const space = String.fromCharCode(0x200b);
---

<section id="font" class="foglio typeface" aria-label="Gianluca Hand">
	<SectionHeader latin="Manus auctoris" it="La mia calligrafia" en="My handwriting" folio="f. III v" />
	<div class="specimen-sheet">
		<div class="specimen-title">
			<h3 class="hand-bold">Gianluca Hand</h3>
			<p><Bilingual it="Ho digitalizzato la mia scrittura, lettera per lettera. Anche qui ogni tratto conserva le piccole irregolarità della mano." en="I digitised my handwriting letter by letter. Each stroke still carries the small irregularities of the hand." /></p>
			<dl>{facts.map(f=><div><dt>{f.value}</dt><dd><Bilingual it={f.it} en={f.en} /></dd></div>)}</dl>
		</div>
		<div class="writing">
			<label for="writing-line" class="imprint"><Bilingual it="Prova il carattere" en="Try the typeface" /></label>
			<div class="guide">
				<input type="text" class="scrittoio-input hand-bold" id="writing-line" maxlength="80" autocomplete="off" spellcheck="false" placeholder={space} />
				<span class="hint hand-bold" aria-hidden="true"><Bilingual it="Scrivi qui…" en="Write here…" /></span>
			</div>
			<p class="alphabet hand-bold" aria-hidden="true">Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj Kk Ll Mm Nn Oo Pp Qq Rr Ss Tt Uu Vv Ww Xx Yy Zz</p>
		</div>
	</div>
	<details>
		<summary><Bilingual it="Dal foglio al font" en="From paper to type" /></summary>
		<div class="notes">
			{[...stages, ...features].map(note=><div><h3><Bilingual it={note.it} en={note.en} /></h3><p><Bilingual it={note.itText} en={note.enText} /></p></div>)}
		</div>
	</details>
</section>

<style>
	.specimen-sheet {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(32px, 5vw, 80px);
		padding: clamp(20px, 3vw, 45px) 0;
		border-block: 1px solid var(--rule);
	}
	.specimen-title h3 {
		margin: 0 0 9px;
		font:
			400 clamp(46px, 4.6vw, 74px)/1 var(--font-hand),
			cursive;
	}
	.specimen-title p {
		margin: 0;
		font-size: 19px;
		line-height: 1.4;
		max-width: 36ch;
	}
	dl {
		display: grid;
		grid-template-columns: 1fr 1fr;
		row-gap: 14px;
		margin: 24px 0 0;
	}
	dt {
		font-style: italic;
		font-size: 22px;
		line-height: 1;
		color: var(--accent-ink);
	}
	dd {
		font-size: 15px;
		margin: 3px 0 0;
	}
	.writing {
		align-self: center;
		min-width: 0;
	}
	.writing label {
		color: var(--accent-ink);
	}
	.guide {
		position: relative;
		margin-top: 12px;
		background: linear-gradient(
			to bottom,
			transparent 27%,
			#8d594255 27% calc(27% + 1px),
			transparent calc(27% + 1px) 75%,
			#8d594255 75% calc(75% + 1px),
			transparent calc(75% + 1px)
		);
		border-bottom: 1px solid var(--rule);
	}
	.scrittoio-input,
	.hint {
		font:
			400 clamp(43px, 4.8vw, 78px)/1.1 var(--font-hand),
			cursive;
	}
	.scrittoio-input {
		display: block;
		border: 0;
		width: 100%;
		min-width: 0;
		padding: 10px 2px;
		color: var(--ink);
		background: transparent;
		border-radius: 0;
	}
	.scrittoio-input:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
	.hint {
		position: absolute;
		left: 2px;
		top: 10px;
		pointer-events: none;
		color: var(--brown);
	}
	.scrittoio-input:not(:placeholder-shown) + .hint {
		visibility: hidden;
	}
	.alphabet {
		margin: 24px 0 0;
		color: var(--accent-ink);
		font:
			400 clamp(28px, 2.4vw, 36px)/1.22 var(--font-hand),
			cursive;
	}
	details {
		border-bottom: 1px solid var(--rule);
	}
	summary {
		cursor: pointer;
		padding: 13px 0;
		color: var(--accent-ink);
		font:
			italic 20px/1.3 var(--font-garamond),
			Georgia,
			serif;
	}
	.notes {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 25px;
		padding: 14px 0 26px;
	}
	.notes h3 {
		margin: 0;
		font-size: 22px;
		font-weight: 400;
	}
	.notes p {
		margin: 4px 0 0;
		font-size: 17px;
		line-height: 1.4;
	}
	@media (max-width: 720px) {
		.specimen-sheet,
		.notes {
			grid-template-columns: 1fr;
		}
		.alphabet {
			margin-top: 16px;
		}
	}
</style>
