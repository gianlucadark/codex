---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import Bilingual from './Bilingual.astro';

interface Props { project: Project; featured?: boolean; }
const { project, featured = false } = Astro.props;
const image = project.images?.[0];
const [statusIt, statusEn = statusIt] = project.status.split(' · ');
---

<a class:list={['work', { featured }]} href={`/progetti/${project.slug}`}>
	{image && <div class="print">
		<Image src={image} widths={featured ? [480, 800, 1200] : [128, 224]}
			sizes={featured ? '(max-width:790px) 90vw, 46vw' : '96px'} alt="" loading="lazy" />
	</div>}
	<div class="entry">
		<span class="imprint ref"><Bilingual it="Tav." en="Pl." /> {project.numeral} <span> / </span> {project.year.split(' · ').at(-1)}</span>
		<h3>{project.title}</h3>
		{featured
			? <><p class="description"><Bilingual it={project.desc} en={project.descEn} /></p>
				<p class="stack">{project.stack} <span>·</span> <Bilingual it={statusIt} en={statusEn} /></p></>
			: <p class="category"><Bilingual it={project.category} en={project.categoryEn} /></p>}
	</div>
	<span class="read"><Bilingual it={featured ? 'Apri la tavola' : 'Apri'} en={featured ? 'Open the plate' : 'Open'} /></span>
</a>

<style>
	.work {
		display: grid;
		grid-template-columns: 84px minmax(0, 1fr) auto;
		gap: clamp(12px, 1.6vw, 23px);
		align-items: center;
		padding: 15px 0;
		text-decoration: none;
	}
	.print {
		position: relative;
		overflow: hidden;
		background: var(--pale-rule);
	}
	.print img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		transition: transform 0.35s ease;
	}
	.work:not(.featured) .print {
		aspect-ratio: 1.38;
	}
	.work:hover .print img,
	.work:focus-visible .print img {
		transform: scale(1.035);
	}
	.work:hover h3,
	.work:focus-visible h3 {
		color: var(--accent-ink);
	}
	.ref {
		display: block;
		font-size: 0.75rem;
		color: var(--accent-ink);
	}
	.ref > span:not(.bil) {
		color: var(--rule);
		margin: 0 2px;
	}
	h3 {
		margin: 5px 0;
		font-weight: 400;
		font-size: clamp(24px, 2.15vw, 34px);
		line-height: 1.05;
		letter-spacing: -0.035em;
		transition: color 0.22s;
	}
	.category,
	.stack {
		color: var(--ink-soft);
		font-size: 16px;
		margin: 0;
		line-height: 1.25;
	}
	.read {
		justify-self: end;
		align-self: center;
		color: var(--accent-ink);
		font-size: 16px;
		font-style: italic;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.featured {
		display: block;
		padding: 0;
	}
	.featured .print {
		padding: 10px;
		border: 1px solid var(--rule);
		background: transparent;
	}
	.featured .print img {
		aspect-ratio: 16/9;
		height: auto;
	}
	.featured .entry {
		margin-top: 19px;
	}
	.featured h3 {
		font-size: clamp(42px, 4.8vw, 72px);
		margin: 7px 0;
	}
	.description {
		font-size: clamp(20px, 1.7vw, 26px);
		line-height: 1.24;
		margin: 0 0 12px;
		max-width: 37ch;
	}
	.stack span:not(.bil) {
		color: var(--accent);
		margin-inline: 3px;
	}
	.featured .read {
		display: inline-block;
		margin-top: 14px;
		font-size: 18px;
	}
	@media (max-width: 1050px) and (min-width: 791px) {
		.work:not(.featured) {
			grid-template-columns: 68px minmax(0, 1fr);
		}
		.work:not(.featured) .read {
			display: none;
		}
	}
	@media (max-width: 500px) {
		.work:not(.featured) {
			grid-template-columns: 70px minmax(0, 1fr);
		}
		.work:not(.featured) .read {
			display: none;
		}
	}
</style>
