---
import { getImage, Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Bilingual from '../../components/Bilingual.astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
	return projects.map((project, i) => {
		const prev = projects[(i - 1 + projects.length) % projects.length];
		const next = projects[(i + 1) % projects.length];
		return {
			params: { slug: project.slug },
			props: { project, prev, next },
		};
	});
}

const { project, prev, next } = Astro.props;
const pageTitle = `${project.title.replace(' Browser Extension', ' Extension')} — Codex`;
const images = project.images ?? [];
const highlights = project.highlights ?? [];
const [cover, ...otherImages] = images;
const [statusIt, statusEn = statusIt] = project.status.split(' · ');

// Optional "problem → approach → result" narrative, only the filled blocks.
const caseBlocks = project.caseStudy
	? [
			{ it: 'Problema', en: 'Problem', body: project.caseStudy.problem },
			{ it: 'Approccio', en: 'Approach', body: project.caseStudy.approach },
			{ it: 'Risultato', en: 'Result', body: project.caseStudy.result },
		].filter((b) => b.body)
	: [];
const technologies = project.stack
	.split('·')
	.map((t) => t.trim())
	.filter(Boolean);

// Per-project social card: convert the first plate to JPG. Gli scraper social
// (WhatsApp, in parte LinkedIn/X) non renderizzano WebP in modo affidabile, quindi
// la card di progetto va in JPG come il generico /og.jpg (fallback quando manca
// un'immagine). Larghezza limitata alla sorgente per non fare upscaling.
const ogSource = images[0];
const ogWidth = ogSource ? Math.min(1200, ogSource.width) : undefined;
const ogCard = ogSource ? await getImage({ src: ogSource, format: 'jpeg', width: ogWidth }) : null;
const ogImage = ogCard?.src ?? site.ogImage;
const ogImageHeight =
	ogSource && ogWidth ? Math.round((ogWidth * ogSource.height) / ogSource.width) : undefined;

// Structured data for the folio: a CreativeWork authored by the site owner.
const year = project.year.match(/\d{4}/)?.[0];
const projectLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.title,
	description: project.descEn,
	inLanguage: ['it', 'en'],
	...(year ? { dateCreated: year } : {}),
	keywords: technologies.join(', '),
	author: { '@type': 'Person', name: site.name },
	url: new URL(`/progetti/${project.slug}`, site.url).href,
};

// Breadcrumb trail: Home › Progetti › {project}. "Progetti" is the anchor on home.
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Codex', item: site.url },
		{ '@type': 'ListItem', position: 2, name: 'Progetti', item: new URL('/#progetti', site.url).href },
		{ '@type': 'ListItem', position: 3, name: project.title },
	],
};
---

<Layout
	title={pageTitle}
	description={`${project.desc} — ${project.descEn}`}
	image={ogImage}
	imageAlt={`${project.title} — Codex`}
	imageWidth={ogWidth}
	imageHeight={ogImageHeight}
	type="article"
	jsonLd={[projectLd, breadcrumbLd]}
>
	<main class="codex manuscript">
		<article class="foglio detail" aria-labelledby="project-title">
			<header class="running">
				<a class="index-link" href="/#progetti"><Bilingual it="Indice delle opere" en="Index of works" /></a>
				<span class="imprint"><Bilingual it="Tavola" en="Plate" /> {project.numeral} · {year}</span>
			</header>

			<div class:list={['opening', { illustrated: cover }]}>
				<div>
					<p class="imprint"><Bilingual it={project.category} en={project.categoryEn} /></p>
					<h1 class="hand-bold" id="project-title">{project.title}</h1>
					<p class="abstract"><Bilingual it={project.desc} en={project.descEn} /></p>
				</div>
				{cover && <figure class="cover">
					<Image src={cover} widths={[480, 800, 1200]} sizes="(max-width: 740px) 94vw, 46vw"
						alt={project.title} loading="eager" />
				</figure>}
			</div>

			<div class="reading">
				<div class="prose">
					<p class="summary"><Bilingual it={project.summary} en={project.summaryEn} /></p>
					{highlights.length > 0 && <section>
						<h2><Bilingual it="Cosa fa" en="What it does" /></h2>
						<ul class="features">{highlights.map(item => <li><Bilingual it={item.it} en={item.en} /></li>)}</ul>
					</section>}
					{caseBlocks.map(block => <section>
						<h2><Bilingual it={block.it} en={block.en} /></h2>
						<p><Bilingual it={block.body!.it} en={block.body!.en} /></p>
					</section>)}
					{project.links && project.links.length > 0 && <div class="links">
						{project.links.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">
							<Bilingual it={link.it} en={link.en} /></a>)}
					</div>}
				</div>
				<aside class="scheda">
					<h2 class="hand-bold"><Bilingual it="Scheda tecnica" en="Technical notes" /></h2>
					<dl>
						<div><dt><Bilingual it="Tecnologie" en="Technologies" /></dt><dd>{project.stack}</dd></div>
						<div><dt><Bilingual it="Anno" en="Year" /></dt><dd>{project.year}</dd></div>
						<div><dt><Bilingual it="Ruolo" en="Role" /></dt><dd>{project.role}</dd></div>
						<div><dt><Bilingual it="Stato" en="Status" /></dt><dd><Bilingual it={statusIt} en={statusEn} /></dd></div>
					</dl>
				</aside>
			</div>

			{otherImages.map((shot, i) => <figure class="supplement">
				<Image src={shot} widths={[480, 800, 1200]} sizes="(max-width: 820px) 92vw, 760px" alt={project.title} loading="lazy" />
				<figcaption class="hand-bold"><Bilingual it="Tav." en="Pl." /> {project.numeral}.{i + 2} · {project.title}</figcaption>
			</figure>)}

			<nav class="pager" aria-label="Altre tavole">
				<a class="pager-link prev" href={`/progetti/${prev.slug}`}>
					<span class="imprint"><Bilingual it="Precedente" en="Previous" /></span>
					<span>{prev.title}</span>
				</a>
				<a class="pager-link next" href={`/progetti/${next.slug}`}>
					<span class="imprint"><Bilingual it="Successiva" en="Next" /></span>
					<span>{next.title}</span>
				</a>
			</nav>
		</article>
	</main>
</Layout>

<style>
	.detail.foglio {
		padding-top: calc(78px + clamp(20px, 2.4vw, 36px));
	}
	.running,
	.pager {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
	}
	.running {
		padding-bottom: 16px;
		border-bottom: 1px solid var(--rule);
	}
	.index-link,
	.links a {
		color: var(--accent-ink);
		text-underline-offset: 4px;
		font-size: 20px;
	}
	.opening {
		margin: clamp(30px, 4.3vw, 64px) 0;
	}
	.illustrated {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
		align-items: center;
		gap: clamp(25px, 5vw, 82px);
	}
	.opening .imprint {
		color: var(--accent-ink);
	}
	h1 {
		margin: 14px 0;
		color: var(--ink-strong);
		font:
			400 clamp(46px, 5.5vw, 84px)/1.04 var(--font-hand),
			cursive;
		overflow-wrap: anywhere;
	}
	.abstract {
		margin: 0;
		max-width: 37ch;
		font-size: clamp(23px, 2.05vw, 31px);
		line-height: 1.26;
		font-style: italic;
	}
	.cover,
	.supplement {
		margin: 0;
	}
	.cover img,
	.supplement img {
		display: block;
		width: 100%;
		height: auto;
		padding: 6px;
		border: 1px solid var(--rule);
	}
	.reading {
		display: grid;
		grid-template-columns: minmax(0, 65ch) minmax(190px, 290px);
		gap: clamp(35px, 8vw, 120px);
		align-items: start;
		padding-top: clamp(26px, 3vw, 48px);
		border-top: 1px solid var(--rule);
	}
	.prose p,
	.features {
		font-size: clamp(20px, 1.48vw, 23px);
		line-height: 1.53;
		margin: 0;
	}
	.prose section {
		margin-top: 30px;
	}
	.prose h2 {
		margin: 0 0 10px;
		font-size: clamp(29px, 2.4vw, 36px);
		line-height: 1.1;
		font-weight: 500;
	}
	.features {
		padding-left: 1.05em;
	}
	.features li {
		padding-left: 0.15em;
		margin: 0.3em 0;
	}
	.features li::marker {
		color: var(--accent);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		margin-top: 28px;
	}
	.scheda {
		border-left: 1px solid var(--rule);
		padding-left: clamp(17px, 2.3vw, 35px);
	}
	.scheda h2,
	.supplement figcaption {
		font:
			400 var(--hand-caption)/1.15 var(--font-hand),
			cursive;
		margin: 0;
		color: var(--accent-ink);
	}
	.scheda dl {
		margin: 14px 0 0;
	}
	.scheda dl > div + div {
		margin-top: 15px;
	}
	.scheda dt {
		font-size: 16px;
		color: var(--brown);
		font-style: italic;
	}
	.scheda dd {
		font-size: 19px;
		margin: 1px 0 0;
		line-height: 1.35;
	}
	.supplement {
		max-width: 760px;
		margin: clamp(32px, 4vw, 60px) 0 0;
	}
	.supplement figcaption {
		margin-top: 8px;
	}
	.pager {
		margin-top: clamp(45px, 5vw, 75px);
		padding-top: 18px;
		border-top: 1px solid var(--rule);
	}
	.pager-link {
		display: grid;
		gap: 4px;
		max-width: 46%;
		font-size: clamp(21px, 2vw, 30px);
		line-height: 1.15;
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	.next {
		text-align: right;
	}
	.pager-link:hover {
		color: var(--accent-ink);
	}
	@media (max-width: 740px) {
		.illustrated,
		.reading {
			grid-template-columns: 1fr;
		}
		.detail.foglio {
			padding-top: 85px;
		}
		.scheda {
			padding-left: 18px;
		}
	}
</style>
