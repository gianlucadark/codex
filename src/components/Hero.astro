---
import { Image } from 'astro:assets';
import Bilingual from './Bilingual.astro';
import illustration from '../assets/pagina-che-si-ripiega.webp';
---

<section class="hero foglio" aria-labelledby="front-title">
	<div class="running imprint">
		<span><Bilingual it="Quaderno di lavoro" en="Working notebook" /></span>
		<span>Sperlonga <b>·</b> MMXXVI</span>
	</div>

	<div class="spread">
		<div class="opening">
			<h1 id="front-title" class="hand-bold">
				Gianluca <span>D'Arcangelo</span>
			</h1>
			<p class="profession"><Bilingual it="Sviluppatore fullstack" en="Fullstack developer" /></p>
			<p class="lead"><Bilingual
				it="Costruisco applicazioni web, disegno interfacce e sperimento con il 3D. Qui raccolgo i lavori e qualche appunto su come sono nati."
				en="I build web applications, design interfaces and experiment with 3D. These pages collect my work and a few notes on how it came about." /></p>
			<a class="open-works" href="#progetti">
				<svg aria-hidden="true" width="21" height="17" viewBox="0 0 24 18" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 4C8 1 4 1 1 2v13c4-1 7-1 11 2 4-3 7-3 11-2V2c-3-1-7-1-11 2Zm0 0v13"/></svg>
				<Bilingual it="Sfoglia i progetti" en="Browse the projects" />
			</a>
		</div>

		<figure class="drawing">
			<Image src={illustration} alt="" draggable="false" widths={[480, 800, 1200, 1536]}
				sizes="(max-width:740px) 96vw, 57vw" quality={87} loading="eager" />
			<figcaption>
				<span class="plate-caption hand-bold"><Bilingual it="Appunti sul portfolio" en="Portfolio sketches" /></span>
				<span class="legend"><Bilingual it="La griglia del sito si piega in un libro. Fra le pagine ricomincia lo stesso disegno." en="The website grid folds into a book. Between its pages, the same drawing begins again." /></span>
			</figcaption>
		</figure>
	</div>
</section>

<style>
	.hero.foglio {
		padding-top: calc(77px + clamp(20px, 2.7vw, 40px));
		padding-bottom: clamp(30px, 3.7vw, 60px);
	}
	.running,
	.running > span:first-child {
		display: flex;
		align-items: center;
	}
	.running {
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 3px 16px;
	}
	.running b {
		font-weight: normal;
		padding-inline: 4px;
	}
	.running > span {
		white-space: nowrap;
	}
	.spread {
		display: grid;
		grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
		align-items: center;
		gap: 1.1%;
		margin-top: clamp(24px, 2.4vw, 40px);
	}
	.opening {
		padding-bottom: 12px;
		position: relative;
		z-index: 1;
	}
	/* The signature is the display voice of the page: big enough to spill
	   over the drawing, where it sits like ink on the same sheet. */
	h1 {
		position: relative;
		z-index: 2;
		width: max-content;
		margin: 0;
		font:
			400 clamp(84px, 12.2vw, 196px)/0.94 var(--font-hand),
			cursive;
		color: var(--ink-strong);
		transform: rotate(-2deg);
		transform-origin: left center;
	}
	h1 span {
		display: block;
		margin-left: 0.42em;
		color: var(--accent-ink);
	}
	.profession {
		margin: clamp(28px, 3.2vw, 52px) 0 0;
		font: 500 0.94rem/1.3 var(--label);
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent-ink);
	}
	.lead {
		margin: 10px 0 22px;
		max-width: 41ch;
		font-size: clamp(18px, 1.32vw, 20px);
		line-height: 1.5;
		color: var(--ink-soft);
	}
	.open-works {
		display: inline-flex;
		gap: 10px;
		align-items: center;
		min-height: 44px;
		padding: 2px 4px;
		color: var(--accent-ink);
		border-bottom: 1px solid currentColor;
		font-size: 19px;
		font-style: italic;
		text-decoration: none;
	}
	.open-works:hover {
		color: var(--ink-strong);
	}
	.drawing {
		margin: 0;
		min-width: 0;
	}
	.drawing img {
		display: block;
		width: 100%;
		height: auto;
		mix-blend-mode: multiply;
		pointer-events: none;
		user-select: none;
	}
	.drawing figcaption {
		margin: 10px 0 0;
		padding-top: 9px;
		border-top: 1px solid var(--rule);
	}
	.plate-caption {
		display: block;
		color: var(--accent-ink);
		font:
			400 clamp(28px, 2.3vw, 36px)/1.1 var(--font-hand),
			cursive;
	}
	.legend {
		display: block;
		color: var(--ink-soft);
		font-size: 16px;
		line-height: 1.3;
		font-style: italic;
		margin-top: 3px;
	}
	@media (max-width: 900px) and (min-width: 741px) {
		h1 {
			font-size: 11vw;
		}
	}
	@media (max-width: 740px) {
		.hero.foglio {
			padding-top: 90px;
		}
		.spread {
			grid-template-columns: 1fr;
			gap: 23px;
			margin-top: 33px;
		}
		h1 {
			font-size: clamp(64px, 19vw, 120px);
		}
		.opening {
			padding: 0;
		}
		.lead {
			max-width: 36ch;
			margin: 9px 0 16px;
		}
		.drawing {
			width: 100%;
			max-width: 540px;
			justify-self: end;
		}
		.running {
			font-size: 0.85rem;
			letter-spacing: 0.045em;
		}
	}
	@media (max-width: 360px) {
		h1 {
			font-size: 62px;
		}
	}
</style>
