---
import Bilingual from './Bilingual.astro';
---

<dialog class="codex-entrance" aria-labelledby="entrance-title" aria-describedby="entrance-description" data-scene="loading" data-state="idle" data-light="candle" tabindex="-1" autofocus>
	<div class="entrance-scene" aria-hidden="true">
		<canvas class="entrance-canvas"></canvas>
	</div>
	<div class="entrance-shade" aria-hidden="true"></div>
	<div class="entrance-frame" aria-hidden="true"></div>
	<!-- Foglio d'attesa: copre il buio finché la scena 3D non è pronta. -->
	<div class="entrance-loader" aria-hidden="true">
		<div class="loader-masthead">
			<p class="loader-edition">Gianluca D’Arcangelo <span>·</span> MMXXVI</p>
			<span class="loader-volume">Vol. I <span>—</span> <Bilingual it="Opere & studi" en="Works & studies" /></span>
		</div>
		<div class="loader-sheet">
			<div class="loader-figure">
				<svg viewBox="0 0 600 600" fill="none" aria-hidden="true">
					<g class="loader-guide">
						<path d="M300 0v600M0 300h600M88 88l424 424M88 512 512 88" />
						<circle cx="300" cy="300" r="270" /><circle cx="300" cy="300" r="218" />
						<rect x="110" y="110" width="380" height="380" />
						<path d="M30 286v28m540-28v28M286 30h28m-28 540h28M105 300h390M300 105v390" />
					</g>
					<g class="loader-orbit">
						<circle cx="300" cy="300" r="250" stroke-dasharray="1 13" />
						<path d="M300 44a256 256 0 0 1 256 256M300 556A256 256 0 0 1 44 300" />
						<path d="m300 35 5 9-5 9-5-9Zm0 512 5 9-5 9-5-9Z" />
					</g>
					<g class="loader-ink">
						<circle cx="300" cy="300" r="234" pathLength="1" transform="rotate(-90 300 300)" />
						<path d="M300 108 492 444H108Z" pathLength="1" />
					</g>
					<g class="loader-book-lines">
						<path d="M300 205c-43-30-84-34-133-23v192c50-10 92-6 133 23 41-29 83-33 133-23V182c-49-11-90-7-133 23Zm0 0v192" pathLength="1" />
						<path d="M179 390c47-7 88-2 121 22 33-24 74-29 121-22M185 208c34-3 64 4 90 17m50 0c26-13 56-20 90-17" pathLength="1" />
					</g>
				</svg>
				<span class="loader-coordinate loader-coordinate-top">Fig. 01 <span>·</span> Initium</span>
				<div class="loader-word"><p class="loader-title">Codex<span class="loader-title-dot">.</span></p></div>
				<span class="loader-coordinate loader-coordinate-bottom">Ars <span>✧</span> Ingenium</span>
			</div>
			<p class="loader-caption"><Bilingual it="Ogni idea comincia da una pagina." en="Every idea begins with a page." /></p>
		</div>
		<div class="loader-ledger">
			<div class="loader-note"><span class="loader-index">I / III</span><p><Bilingual it="Si prepara il codice" en="Binding the codex" /></p><span class="loader-detail"><Bilingual it="Materia, luce, meraviglia." en="Matter, light, wonder." /></span></div>
			<div class="loader-meter"><span class="loader-meter-label"><Bilingual it="Composizione" en="Composition" /></span><p class="loader-count">00</p></div>
			<div class="loader-rule"><span></span></div>
		</div>
	</div>
	<header class="entrance-heading">
		<p class="entrance-edition">Gianluca D’Arcangelo <span>·</span> MMXXVI</p>
		<h2 id="entrance-title">Codex</h2>
		<p id="entrance-description"><Bilingual it="Ogni idea comincia da una pagina." en="Every idea begins with a page." /></p>
	</header>
	<button class="entrance-book" type="button">
		<span class="sr-only"><Bilingual it="Apri il libro ed entra nel portfolio" en="Open the book and enter the portfolio" /></span>
	</button>
	<div class="entrance-invitation">
		<span class="entrance-ornament" aria-hidden="true">✧</span>
		<button class="entrance-open" type="button">
			<Bilingual it="apri il codice" en="open the codex" />
			<svg viewBox="0 0 32 16" width="32" height="16" aria-hidden="true"><path d="M1 8h28m-6-6 6 6-6 6" /></svg>
		</button>
		<p class="entrance-caption"><Bilingual it="Un libro da esplorare. Una pagina da abitare." en="A book to explore. A page to inhabit." /></p>
	</div>
	<footer class="entrance-footer">
		<button class="entrance-light" type="button" aria-pressed="true">
			<svg viewBox="0 0 16 24" width="14" height="21" aria-hidden="true">
				<path class="light-flame" d="M8 1.5c2.6 3.2 3.6 5.4 3.6 7.3A3.6 3.6 0 0 1 8 12.4a3.6 3.6 0 0 1-3.6-3.6c0-1.9 1-4.1 3.6-7.3Z" />
				<path class="light-wick" d="M8 12.4v2.4" />
				<rect x="4.5" y="14.8" width="7" height="7.7" rx=".6" />
			</svg>
			<span class="light-off"><Bilingual it="Accendi la candela" en="Light the candle" /></span>
			<span class="light-on"><Bilingual it="Spegni la candela" en="Snuff the candle" /></span>
		</button>
		<button class="entrance-skip" type="button"><Bilingual it="Salta introduzione" en="Skip introduction" /><span aria-hidden="true"> ↗</span></button>
	</footer>
	<p class="entrance-status sr-only" role="status" aria-live="polite"></p>
	<div class="entrance-progress" aria-hidden="true"></div>
</dialog>

<script>
	import { setupCodexEntrance } from '../scripts/codex-entrance';
	setupCodexEntrance();
</script>

<style>
	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
	.codex-entrance {
		position: fixed; inset: 0; width: 100%; max-width: none; height: 100%; height: 100dvh;
		max-height: none; margin: 0; padding: 0; border: 0; overflow: hidden;
		background: #19110d; color: #f0dfbd; isolation: isolate;
		--entrance-exit: 0; --entrance-progress: 0;
		opacity: calc(1 - var(--entrance-exit));
	}
	.codex-entrance::backdrop { background: transparent; }
	.codex-entrance:focus { outline: none; }
	.entrance-scene, .entrance-shade, .entrance-frame { position: absolute; inset: 0; pointer-events: none; }
	.entrance-scene { z-index: -3; }
	.entrance-canvas { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
	.entrance-canvas { opacity: 0; }
	.codex-entrance[data-scene='ready'] .entrance-canvas { opacity: 1; }
	.entrance-shade {
		z-index: -2; background: linear-gradient(180deg, rgb(14 9 6 / .8), transparent 32%, transparent 62%, rgb(14 9 6 / .87)),
			radial-gradient(ellipse at 50% 47%, transparent 30%, rgb(12 8 5 / .46) 100%);
		transition: opacity 2s cubic-bezier(.22, .61, .36, 1);
	}
	.entrance-frame { z-index: -1; inset: 24px; border: 1px solid rgb(239 213 169 / .16); transition: opacity 2s cubic-bezier(.22, .61, .36, 1); }
	/* The loader stays opaque until the live scene has rendered. */
	.entrance-loader {
		position: absolute; inset: 0; z-index: 1; display: grid; place-items: center; padding: 24px;
		background:
			radial-gradient(ellipse at 50% 50%, transparent 55%, rgb(58 42 24 / .22) 100%),
			radial-gradient(125% 85% at 26% 10%, #ead8b1 0%, #e2d0a8 42%, #dbc8a0 72%, var(--paper) 100%);
		color: var(--ink-strong);
		transition: opacity 1.2s cubic-bezier(.22, 1, .36, 1), visibility 0s linear 1.2s;
	}
	.entrance-loader::before { content: ''; position: absolute; inset: 24px; border: var(--hairline) solid rgb(110 86 56 / .35); pointer-events: none; }
	.codex-entrance[data-scene='ready'] .entrance-loader { opacity: 0; visibility: hidden; }
	.loader-masthead { position: absolute; top: clamp(34px, 5.3vh, 64px); left: clamp(32px, 5vw, 90px); right: clamp(32px, 5vw, 90px); display: flex; justify-content: space-between; gap: 24px; align-items: center; }
	.loader-edition, .loader-volume { margin: 0; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--brown); }
	.loader-edition > span, .loader-volume > span { color: var(--accent); padding: 0 8px; }
	.loader-sheet { display: grid; justify-items: center; text-align: center; margin-top: -4vh; }
	.loader-figure { position: relative; width: min(59vh, 580px, 75vw); aspect-ratio: 1; display: grid; place-items: center; }
	.loader-figure svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
	.loader-guide { stroke: var(--brown); stroke-width: .65; opacity: .22; }
	.loader-orbit { stroke: var(--accent-ink); stroke-width: .9; opacity: .52; transform-origin: 300px 300px; animation: loader-orbit 32s linear infinite; }
	.loader-ink > * { stroke: var(--accent); stroke-width: 1.25; stroke-linecap: round; stroke-dasharray: 1 1; stroke-dashoffset: calc(1 - var(--entrance-load, 0)); transition: stroke-dashoffset .65s ease; }
	.loader-ink path { stroke: var(--brown); opacity: .5; stroke-width: .8; }
	.loader-book-lines { stroke: var(--brown); stroke-width: .8; opacity: .24; }
	.loader-book-lines path { stroke-dasharray: 1; animation: loader-bind 3s cubic-bezier(.2,.7,.2,1) both; }
	.loader-book-lines path + path { animation-delay: .4s; }
	.loader-word { position: relative; width: 145%; padding: 14px 0 24px; }
	.loader-word::before { content: ''; position: absolute; inset: 12% 5%; background: radial-gradient(ellipse, #e2d0a8 30%, rgb(226 208 168 / .88) 47%, transparent 72%); }
	.loader-title { position: relative; margin: 0; color: var(--ink-strong); font: 400 clamp(112px, 15vw, 230px)/.95 var(--font-hand), cursive; letter-spacing: -.055em; padding-right: .06em; -webkit-font-smoothing: auto; text-shadow: var(--hand-bold); animation: loader-write 1.5s cubic-bezier(.16,1,.3,1) both; }
	.loader-title-dot { color: var(--accent-ink); }
	.loader-coordinate { position: absolute; font-style: italic; font-size: 12px; letter-spacing: .17em; color: var(--brown); }
	.loader-coordinate span { color: var(--accent); margin: 0 12px; }
	.loader-coordinate-top { top: 17%; }
	.loader-coordinate-bottom { bottom: 16%; }
	.loader-caption { margin: 12px 0 0; font-size: clamp(15px, 1.35vw, 19px); font-style: italic; color: var(--accent-ink); animation: loader-in 1.2s .3s both; }
	.loader-ledger { position: absolute; left: clamp(32px, 5vw, 90px); right: clamp(32px, 5vw, 90px); bottom: clamp(94px, 12vh, 130px); display: flex; justify-content: space-between; align-items: end; gap: 24px; padding-bottom: 16px; }
	.loader-index, .loader-meter-label { font-size: 9px; text-transform: uppercase; letter-spacing: .22em; color: var(--brown); }
	.loader-note p { margin: 7px 0 4px; font-size: 17px; font-style: italic; color: var(--ink-strong); }
	.loader-detail { color: var(--brown); font-size: 11px; letter-spacing: .045em; }
	.loader-meter { text-align: right; }
	.loader-count { margin: 1px 0 -4px; color: var(--ink-strong); font-size: clamp(42px, 5vw, 66px); line-height: 1; letter-spacing: -.06em; font-variant-numeric: lining-nums tabular-nums; }
	.loader-count::after { content: '%'; margin-left: 7px; font-size: 15px; letter-spacing: 0; color: var(--accent-ink); }
	.loader-rule { position: absolute; bottom: 0; left: 0; right: 0; height: 1px; background: rgb(110 86 56 / .22); overflow: hidden; }
	.loader-rule span { display: block; width: 100%; height: 100%; background: var(--accent-ink); transform: scaleX(var(--entrance-load, 0)); transform-origin: left; transition: transform .65s ease; }
	.codex-entrance:not([data-load='known']) .loader-rule span { animation: loader-search 2.4s ease-in-out infinite; }
	.codex-entrance[data-scene='ready'] .loader-sheet { transform: scale(1.035); opacity: 0; transition: transform 1.2s ease, opacity .7s ease; }
	@keyframes loader-orbit { to { transform: rotate(360deg); } }
	@keyframes loader-bind { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
	@keyframes loader-write { from { opacity: 0; clip-path: inset(0 100% 0 0); transform: translateY(14px); } to { opacity: 1; clip-path: inset(0); transform: none; } }
	@keyframes loader-in { from { opacity: 0; transform: translateY(8px); } }
	@keyframes loader-search { 0% { transform: translateX(-100%) scaleX(.25); } 100% { transform: translateX(100%) scaleX(.25); } }
	@media (max-width: 600px) {
		.loader-volume { display: none; }
		.loader-edition { font-size: 9px; letter-spacing: .13em; }
		.loader-masthead { justify-content: center; }
		.loader-figure { width: min(77vw, 45vh); }
		.loader-title { font-size: clamp(108px, 29vw, 170px); }
		.loader-caption { max-width: 260px; }
		.loader-coordinate { font-size: 10px; letter-spacing: .1em; }
		.loader-note p { font-size: 15px; }
		.loader-detail { font-size: 10px; }
	}
	@media (max-height: 620px) and (min-aspect-ratio: 4/3) {
		.loader-figure { width: 52vh; }
		.loader-title { font-size: 25vh; }
		.loader-ledger { bottom: 68px; }
		.loader-caption, .loader-detail, .loader-coordinate { display: none; }
		.loader-count { font-size: 38px; }
	}
	/* "Salta" resta raggiungibile sopra il foglio, in inchiostro. */
	.entrance-footer { z-index: 2; }
	.codex-entrance:not([data-scene='ready']) .entrance-skip { color: var(--ink-soft); }
	.entrance-heading { position: absolute; top: clamp(42px, 6.2vh, 80px); width: 100%; text-align: center; pointer-events: none; }
	.entrance-edition { font-size: 11px; letter-spacing: .23em; text-transform: uppercase; margin: 0 0 8px; }
	.entrance-edition > span { padding: 0 9px; color: #cba56d; }
	h2 { font: 400 clamp(60px, 7vw, 100px)/1 var(--font-hand), cursive; margin: 0; text-shadow: 0 2px 30px #160d07; }
	#entrance-description { font-style: italic; font-size: clamp(15px, 1.2vw, 19px); margin: 8px 0 0; color: #e5cfac; }
	.entrance-book { position: absolute; left: 25%; top: 29%; width: 49%; height: 48%; background: transparent; border: 0; cursor: pointer; border-radius: 35%; touch-action: none; }
	.entrance-book:focus-visible { outline: 1px solid #f0dfbd; outline-offset: 12px; }
	.entrance-invitation { position: absolute; bottom: clamp(80px, 10vh, 130px); width: 100%; display: grid; justify-items: center; gap: 8px; }
	.entrance-ornament { font-size: 24px; line-height: 1; color: #dfbc83; }
	.entrance-open { display: flex; align-items: center; gap: 18px; padding: 5px 14px 10px; border: 0; background: transparent; color: inherit; cursor: pointer; font: 400 clamp(35px, 3.2vw, 46px)/1.15 var(--font-hand), cursive; }
	.entrance-open svg { fill: none; stroke: #dfbc83; stroke-width: 1; transition: transform .35s ease; }
	.entrance-open:hover svg { transform: translateX(7px); }
	.entrance-open:focus-visible, .entrance-skip:focus-visible { outline: 1px solid #f0dfbd; outline-offset: 5px; }
	.entrance-caption { margin: 0; font-size: 12px; letter-spacing: .12em; color: #e5cfac; }
	.entrance-footer { position: absolute; left: 48px; right: 48px; bottom: max(37px, env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: space-between; gap: 20px; }
	.entrance-folio { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #dfc9a8; }
	.entrance-folio > span[aria-hidden] { margin: 0 12px; opacity: .5; }
	.entrance-skip { border: 0; background: transparent; color: #e5cfac; font: inherit; font-size: 13px; padding: 12px 0 12px 12px; cursor: pointer; }
	.entrance-skip:hover { color: #fff4df; }
	/* — Luce di candela — solo quando la scena 3D è viva: spegne lo studio e
	 * lascia il libro alla fiamma. */
	.entrance-light {
		display: inline-flex; align-items: center; gap: 12px; margin-right: auto; min-height: 44px; padding: 9px 20px 9px 14px;
		border: 1px solid rgb(239 213 169 / .42); border-radius: 999px;
		background: rgb(25 16 11 / .62); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
		color: #f0dfbd; font: inherit; font-size: 15px; letter-spacing: .04em; cursor: pointer;
		box-shadow: 0 6px 22px rgb(0 0 0 / .35);
		opacity: 0; visibility: hidden;
		transition: opacity .5s ease, visibility 0s linear .5s, color .3s, border-color .3s, background .3s;
	}
	.codex-entrance[data-scene='ready']:not(:is([data-state='playing'], [data-state='closing'])) .entrance-light {
		opacity: 1; visibility: visible; transition: opacity .5s ease, color .3s, border-color .3s, background .3s;
	}
	.entrance-light:hover { color: #fff4df; border-color: rgb(255 194 128 / .8); background: rgb(48 30 18 / .72); }
	/* Al buio il pulsante prende il colore della fiamma. */
	.entrance-light[aria-pressed='true'] {
		color: #ffe2b8; border-color: rgb(255 170 92 / .75); background: rgb(40 20 8 / .7);
	}
	.entrance-light:focus-visible { outline: 1px solid #f0dfbd; outline-offset: 5px; }
	.entrance-light svg { flex: none; width: 18px; height: 27px; fill: none; stroke: currentColor; stroke-width: 1.1; }
	.entrance-light .light-flame { fill: #ffb45c; stroke: #ffb45c; opacity: .45; transition: opacity 1.4s ease; }
	.entrance-light[aria-pressed='true'] .light-flame { opacity: 1; filter: drop-shadow(0 0 4px #ff9d44); animation: light-flicker 2.2s ease-in-out infinite alternate; transform-origin: 50% 90%; }
	.entrance-light .light-on, .entrance-light[aria-pressed='true'] .light-off { display: none; }
	.entrance-light[aria-pressed='true'] .light-on { display: inline; }
	@keyframes light-flicker { 50% { transform: scale(.94, 1.04); opacity: .85; } }
	/* Al buio la cornice e le ombre dipinte si ritirano: resta solo la fiamma. */
	.codex-entrance[data-light='candle'] .entrance-frame { opacity: .45; }
	.codex-entrance[data-light='candle'] .entrance-shade { opacity: .3; }
	.entrance-heading, .entrance-invitation { transition: opacity .55s ease, transform .7s ease; }
	/* Reveal the invitation after the loader begins dissolving. */
	.codex-entrance[data-scene='loading'] :is(.entrance-heading, .entrance-invitation) { opacity: 0; }
	.codex-entrance[data-scene='ready'] :is(.entrance-heading, .entrance-invitation) { transition-delay: .35s; }
	.codex-entrance[data-state='loading'] .entrance-ornament, .codex-entrance[data-scene='loading'] .entrance-ornament { animation: entrance-breathe 1.4s ease-in-out infinite alternate; }
	.codex-entrance:is([data-state='playing'], [data-state='closing']) :is(.entrance-heading, .entrance-invitation) { opacity: 0; transform: translateY(-10px); pointer-events: none; }
	.codex-entrance:is([data-state='playing'], [data-state='closing']) :is(.entrance-shade, .entrance-frame, .entrance-folio) { opacity: 0; }
	.codex-entrance:is([data-state='playing'], [data-state='closing']) .entrance-book { pointer-events: none; }
	.codex-entrance[data-state='closing'] .entrance-skip { display: none; }
	.entrance-progress { position: absolute; bottom: 0; left: 0; width: 100%; height: 2px; background: #dbb77e; transform: scaleX(var(--entrance-progress)); transform-origin: left; }
	@keyframes entrance-breathe { to { opacity: .25; } }

	@media (max-aspect-ratio: 3/4) {
		.entrance-shade { background: linear-gradient(180deg, rgb(14 9 6 / .3), transparent 35%, transparent 62%, rgb(14 9 6 / .5)); }
		.entrance-heading { top: max(60px, 8svh); }
		.entrance-book { left: 12%; top: 32%; width: 76%; height: 36%; }
		.entrance-invitation { bottom: max(105px, 12svh); }
	}
	@media (max-width: 600px) {
		.entrance-frame, .entrance-loader::before { inset: 14px; }
		.entrance-footer { left: 27px; right: 27px; bottom: max(25px, env(safe-area-inset-bottom)); }
		.entrance-edition { font-size: 9px; letter-spacing: .16em; }
		.entrance-folio { font-size: 9px; }
		.entrance-folio > span[aria-hidden] { margin: 0 6px; }
		.entrance-skip { font-size: 12px; min-height: 44px; }
		.entrance-light { font-size: 13px; gap: 9px; padding: 7px 15px 7px 11px; }
	}
	@media (max-height: 540px) and (min-aspect-ratio: 4/3) {
		.entrance-heading { top: 27px; }
		h2 { font-size: 48px; }
		.entrance-edition, #entrance-description, .entrance-caption, .entrance-ornament { display: none; }
		.entrance-invitation { bottom: 53px; }
		.entrance-footer { bottom: 16px; }
	}
	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after { animation: none !important; transition: none !important; }
	}
</style>
