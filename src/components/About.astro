---
import { Image } from 'astro:assets';
import Bilingual from './Bilingual.astro';
import SectionHeader from './SectionHeader.astro';
import portrait from '../assets/ritratto.webp';

const stats = [
	{ value: '6+', it: 'anni di esperienza', en: 'years of experience' },
	{ value: '10+', it: 'progetti', en: 'projects' },
	{ value: '3', it: 'riconoscimenti', en: 'awards' },
];
---
<section id="chi-sono" class="foglio author" aria-label="Chi sono">
	<div class="spread">
		<figure>
			<div class="mount"><Image src={portrait} widths={[360, 640, 880]} sizes="(max-width: 700px) 75vw, 32vw" alt="Gianluca D’Arcangelo e la sua gatta siberiana Dolly" loading="lazy" /></div>
			<figcaption>
				<span class="portrait-name hand-bold"><Bilingual it="Dolly e il sottoscritto" en="Dolly and yours truly" /></span>
				<Bilingual as="p" it="Avevo previsto un autoritratto. Dolly, la mia siberiana, ha insistito per un ritratto di gruppo." en="I had planned a self-portrait. Dolly, my Siberian cat, insisted on a group portrait." />
			</figcaption>
		</figure>
		<div class="bio">
			<SectionHeader latin="De auctore" it="L’autore" en="The author" folio="f. II v" />
			<p class="incipit"><Bilingual it="Mente e mano, codice e forma." en="Mind and hand, code and form." /></p>
			<p><Bilingual it="Sul lavoro costruisco applicazioni enterprise con Angular e Java. Nei miei progetti sperimento con React, Node e Three.js, e scendo fino a Rust quando la performance conta." en="At work I build enterprise applications with Angular and Java. In my own projects I experiment with React, Node and Three.js, and reach for Rust when performance matters." /></p>
			<p><Bilingual it="Mi interessa tanto come è scritto un sistema quanto come si sente chi lo usa. Per questo curo l’accessibilità e la velocità fin dal primo prototipo." en="I care as much about how a system is written as how it feels to use. That’s why I work on accessibility and speed from the very first prototype." /></p>
			<dl>
				{stats.map(s => <div><dt class="hand-bold">{s.value}</dt><dd><Bilingual it={s.it} en={s.en} /></dd></div>)}
			</dl>
		</div>
	</div>
</section>

<style>
	.spread {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.12fr);
		align-items: center;
		gap: clamp(40px, 8vw, 128px);
	}
	figure {
		margin: 0 auto;
		width: min(100%, 365px);
		transform: rotate(-2deg);
	}
	.mount {
		padding: 9px;
		background: #f1e8d1;
		box-shadow: 1px 3px 6px #46351c2e;
		border: 1px solid #b8a78a;
	}
	img {
		display: block;
		width: 100%;
		height: auto;
	}
	figcaption {
		margin-top: 12px;
		text-align: center;
	}
	.portrait-name {
		display: block;
		color: var(--accent-ink);
		font:
			400 var(--hand-caption)/1.1 var(--font-hand),
			cursive;
	}
	figcaption :global(p) {
		max-width: 35ch;
		margin: 5px auto 0;
		font-size: 17px;
		font-style: italic;
		line-height: 1.3;
	}
	.bio p {
		font-size: clamp(18px, 1.32vw, 20px);
		line-height: 1.5;
		max-width: 48ch;
		margin: 12px 0;
	}
	.bio .incipit {
		font-style: italic;
		font-size: clamp(26px, 2.6vw, 38px);
		line-height: 1.1;
		margin: 0 0 20px;
		color: var(--accent-ink);
	}
	dl {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(18px, 3vw, 48px);
		margin: 25px 0 0;
		padding: 18px 0 0;
		border-top: 1px solid var(--rule);
	}
	dt {
		font:
			400 var(--hand-title)/1 var(--font-hand),
			cursive;
		color: var(--accent-ink);
	}
	dd {
		margin: 3px 0 0;
		font-size: 16px;
	}
	@media (max-width: 700px) {
		.spread {
			grid-template-columns: 1fr;
			gap: 35px;
		}
		.bio {
			grid-row: 1;
		}
		figure {
			max-width: 290px;
		}
	}
</style>
